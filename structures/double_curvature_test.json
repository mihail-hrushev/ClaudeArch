    "blueGlass": { "color": [0.14, 0.2, 0.54], "alpha": 0.4, "metallic": 0.95, "roughness": 0.01, "emissive": [0.3, 0.3, 0.3] }
  },
  "glass": {
    "clear": { "width": "500mm", "length": "1000mm", "thickness": "12mm", "material": "blueGlass", "align": "bottom-center" }
  },
  "surfaces": {
