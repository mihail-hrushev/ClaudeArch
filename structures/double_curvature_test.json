{
  "name": "double_curvature_test",
  "description": "Test of surface2: one glass surface curved in two directions. `tangent` bends the section from the base up to alongZ, `tangentX` bends the base line from the base to alongX ([1, 0] flat, [0, 1] or [0, -1] a semicircle), `sweep` slides the section along it or revolves it about its axis.",
  "material": "steel",
  "view": { "target": [950, 300, 250], "radius": 2800, "alpha": -60, "beta": 65 },
  "profiles": {
    "rib": { "rect": ["50mm", "140mm"] },
    "cutRib": { "rect": ["80mm", "200mm"] },
    "frame": { "rect": ["30mm", "80mm"] },
    "mullion": { "rect": ["30mm", "60mm"] }
  },
  "materials": {
