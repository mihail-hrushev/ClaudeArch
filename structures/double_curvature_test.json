      "cuts": [{ "point": [0, 0, 0], "normal": [0.866025, -0.5, 0] },
               { "point": ["7000mm", 0, 0], "normal": [-0.866025, -0.5, 0] }] },
    { "op": "surface2", "name": "shell2", "type": "shell",
      "base": [0, 500, 0], "alongX": ["14m", 500, 0], "alongZ": [0, 900, 500],
      "tangent": [0, 1], "tangentX": [0.0, -1], "sweep": "revolve" },
    { "op": "surface2", "name": "shell3", "type": "shell",
