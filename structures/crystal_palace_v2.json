{
  "name": "crystal_palace_v2",
  "description": "Crystal palace, second design, built step by step. Stage 1: an 8 x 8 m square (first 10 x 10 m) on the ground with four hexagonal columns 10 m tall (600 mm across the corners), one at each corner. Stage 2: one 2 x 2 m arched window standing free, its base centre 2 m above the origin. Stage 3: a hipped glass dome of four surfaces from the column tops to a point 17 m above the origin. Stage 4: a gabled porch roof 4 m deep in front, from mid-height of the front columns up to a ridge at the column tops, with two windows in each of its sides. Stage 5: the porch, its windows, the lower roofs and the glass beam as one group placed on all four sides. Stage 6: a second porch bay with rectangular lower roofs, each ending on a lower wall of two windows. Stage 7: the porch split into its first segment, middle bays and end; the side arms (porchLong) one bay longer than the back arm, as in the real plan.",
  "material": "steel",
  "view": { "target": [0, 0, 500], "radius": 2600, "alpha": 125, "beta": 70 },
  "profiles": {
    "column": { "regular": 6, "radius": "200mm" },
    "windowFrame": { "rect": ["60mm", "60mm"] },
    "windowFrameVertical": { "rect": ["100mm", "200mm"] },
    "windowPost": { "rect": ["30mm", "30mm"] },
    "windowRib": { "rect": ["30mm", "30mm"] },
    "porchColumn": { "regular": 6, "radius": "120mm" },
    "porchPlinth": { "rect": ["320mm", "320mm"] },
    "porchTorus": { "regular": 16, "radius": "170mm" },
    "porchFillet": { "regular": 16, "radius": "140mm" },
    "porchAstragal": { "regular": 16, "radius": "145mm" },
    "porchEchinus": { "regular": 16, "radius": "175mm" },
    "porchAbacus": { "rect": ["360mm", "360mm"] },
    "columnPlinth": { "rect": ["540mm", "540mm"] },
    "columnTorus": { "regular": 16, "radius": "285mm" },
    "columnFillet": { "regular": 16, "radius": "235mm" },
    "columnAstragal": { "regular": 16, "radius": "245mm" },
    "columnEchinus": { "regular": 16, "radius": "295mm" },
    "columnAbacus": { "rect": ["600mm", "600mm"] },
    "porchArch": { "circle": "60mm" }
  },
  "materials": {
    "steel": { "color": [0, 0, 0], "metallic": 0.95, "roughness": 0.05 },
    "masonry": { "color": [0.34, 0.34, 0.33], "metallic": 0, "roughness": 0.9 },
    "orangeGlass": { "color": [0.62, 0.85, 0.82], "alpha": 0.5, "reflection": 0.5 },
    "blueGlass": { "color": [0.14, 0.2, 0.54], "alpha": 0.4, "metallic": 0.95, "roughness": 0.01, "emissive": [1, 0.5, 0] }
  },
  "glass": {
    "clear": { "width": "400mm", "length": "800mm", "thickness": "10mm", "material": "blueGlass", "align": "middle-center" },
    "square": { "width": "1m", "length": "1m", "thickness": "10mm", "material": "blueGlass" }
  },
  "surfaces": {
    "glazing": {
      "ribStep": "2000mm",
      "ribsOnGrid": "symmetric",
      "tile": { "preset": "clear", "align": "bottom-center" },
      "profiles": { "mainRib": { "rect": ["100mm", "140mm"] }, 
                    "cutRib": { "rect": ["120mm", "200mm"] }, 
                    "horizontalFrame": { 
                      "rect": ["30mm", "80mm"] }, 
                      "verticalFrame": { "rect": ["30mm", "60mm"] } }
    },
    "glassBeam": { "extends": "glazing", "tile": { "preset": "square", "align": "bottom-left" },
                   "profiles": { "mainRib": { "rect": ["100mm", "140mm"] }, "cutRib": { "rect": ["100mm", "140mm"] },
                                 "horizontalFrame": { "rect": ["100mm", "140mm"] }, "verticalFrame": { "rect": ["100mm", "140mm"] } } }
  },
  "levels": {
    "baseSize": "8m",
    "half": "baseSize / 2",
    "bay": "4m",
    "aisle": "4m",
    "domeTop": "21m",
    "columnTop": "15m",
    "beamFoot": "14m",
    "columnMiddle": "11m",
    "upperWindowSpring": "10m",
    "porchWindowFoot": "8m", 
    "beltFoot": "7.5m",
    "porchArchSpring": "5.5m",
    "lowRoofEave": "4.5m",
    "lowWindowSpring": "3.4m",
    "foundationTop": "600mm",
    "ground": "150mm"
  },
  "tangents": {
    "porchTopTangent": [0.5, 1],
    "porchEndTangent": [0.35, 1],
    "lowRoofTangent": [0.5, 1],
    "lowRoofRingTangent": [0.43, 1]
  },
  "plan": {
    "frontPorch": { "rect": ["baseSize", "bay"], "center": [0, "-half - bay / 2"] },
    "base": { "rect": ["baseSize", "baseSize"] }
  },
  "groups": {
    "porchBay": {
      "description": "One 4 m bay of a porch, written for the first bay in front: the gabled roof between the front columns and two windows in each of its sides.",
      "plan": {
        "porch": { "rect": ["baseSize", "bay"], "center": [0, "-half - bay / 2"] }
      },
      "build": [
        { "op": "surface", "name": "porchLeft", "type": "glazing", "evenBays": false,
          "base": { "column": ["cornerColumns", 0], "z": "columnMiddle" }, 
          "alongX": ["-half", "-half - bay", "columnMiddle"],
          "alongZ": [0, "-half", "beamFoot"], "tangent": "porchTopTangent" },
        { "op": "surface", "name": "porchRight", "type": "glazing", "evenBays": false,
          "base": ["half", "-half - bay", "columnMiddle"], 
          "alongX": { "column": ["cornerColumns", 1], "z": "columnMiddle" },
          "alongZ": [0, "-half - bay", "beamFoot"], "tangent": "porchTopTangent" },
        { "op": "window", "name": "porchRightWindow1", "sidesOnEdges": true, "side": ["porch", 1], "part": [0, 2], "foot": "porchWindowFoot", "top": "columnMiddle", "spring": "upperWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "window", "name": "porchRightWindow2", "sidesOnEdges": true, "side": ["porch", 1], "part": [1, 2], "foot": "porchWindowFoot", "top": "columnMiddle", "spring": "upperWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "window", "name": "porchLeftWindow1", "sidesOnEdges": true, "side": ["porch", 3], "part": [0, 2], 
          "foot": "porchWindowFoot", "top": "columnMiddle", "spring": "upperWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "window", "name": "porchLeftWindow2", "sidesOnEdges": true, "side": ["porch", 3], "part": [1, 2], "foot": "porchWindowFoot", "top": "columnMiddle", "spring": "upperWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "band", "name": "belt", "plan": "porch", "sides": [1, 3], "thickness": "150mm", "z": ["beltFoot", "porchWindowFoot"], "material": "masonry" }
      ]
    },
    "porchSegment": {
      "description": "The first 4 m segment of a porch, written for the front: one porch bay on four porch columns joined by thin arches, the glass beam and the arch screen between the main columns, and the triangular lower roofs beside it.",
      "build": [
        { "op": "group", "name": "bay1", "use": "porchBay" },
        { "op": "columns", "name": "porchColumnsRight", "at": { "points": [["half", "-half", 0], ["half", "-half - bay", 0]] },
          "profile": "porchColumn", "foot": "ground", "top": "beltFoot",
          "base": [{ "profile": "porchPlinth", "height": "150mm" }, { "profile": "porchTorus", "height": "70mm" }, { "profile": "porchFillet", "height": "30mm" }],
          "capital": [{ "profile": "porchAstragal", "height": "35mm" }, { "profile": "porchEchinus", "height": "90mm" }, { "profile": "porchAbacus", "height": "60mm" }] },
        { "op": "columns", "name": "porchColumnsLeft", "at": { "points": [["-half", "-half", 0], ["-half", "-half - bay", 0]] },
          "profile": "porchColumn", "foot": "ground", "top": "beltFoot",
          "base": [{ "profile": "porchPlinth", "height": "150mm" }, { "profile": "porchTorus", "height": "70mm" }, { "profile": "porchFillet", "height": "30mm" }],
          "capital": [{ "profile": "porchAstragal", "height": "35mm" }, { "profile": "porchEchinus", "height": "90mm" }, { "profile": "porchAbacus", "height": "60mm" }] },
        { "op": "arches", "name": "porchArchesRight", "between": "porchColumnsRight", "open": true, "profile": "porchArch", "under": { "columns": 0 }, "spring": "porchArchSpring" },
        { "op": "arches", "name": "porchArchesLeft", "between": "porchColumnsLeft", "open": true, "profile": "porchArch", "under": { "columns": 0 }, "spring": "porchArchSpring" },
        { "op": "surface", "name": "beam", "type": "glassBeam", "evenBays": false,
          "base": { "column": ["cornerColumns", 0], "z": "beamFoot" }, "alongX": { "column": ["cornerColumns", 1], "z": "beamFoot" },
          "alongZ": { "column": ["cornerColumns", 0], "z": "columnTop" } },
        { "op": "archSurface", "name": "archScreen", "from": { "column": ["cornerColumns", 0] }, "to": { "column": ["cornerColumns", 1] },
          "inset": "170mm", "foot": "columnMiddle", "top": "beamFoot", "ribStep": "400mm",
          "floor": [{ "from": { "column": ["cornerColumns", 0], "z": "columnMiddle" }, "to": [0, "-half", "beamFoot"], "tangent": "porchTopTangent" },
                    { "from": { "column": ["cornerColumns", 1], "z": "columnMiddle" }, "to": [0, "-half", "beamFoot"], "tangent": "porchTopTangent" }],
          "profiles": { "frame": "windowFrame", "rib": "windowRib", "arch": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "surface", "name": "lowRoofRight", "type": "glazing", "evenBays": false,
          "base": ["half + aisle", "-half - bay", "lowRoofEave"], "alongX": ["half + aisle", "-half", "lowRoofEave"],
          "alongZ": ["half", "-half - bay", "beltFoot"], "tangent": "lowRoofTangent",
          "cuts": [{ "point": { "column": ["cornerColumns", 1], "z": 0 }, "normal": [-1, -1, 0] }] },
        { "op": "surface", "name": "lowRoofLeft", "type": "glazing", "evenBays": false,
          "base": ["-half - aisle", "-half", "lowRoofEave"], "alongX": ["-half - aisle", "-half - bay", "lowRoofEave"],
          "alongZ": ["-half", "-half", "beltFoot"], "tangent": "lowRoofTangent",
          "cuts": [{ "point": { "column": ["cornerColumns", 0], "z": 0 }, "normal": [1, -1, 0] }] }
      ]
    },
    "porchMiddle": {
      "description": "A further 4 m porch bay, written as the second (y from -8 m to -12 m): porch columns joined by thin arches, the porch bay, rectangular lower roofs each side ending on a lower wall of two windows.",
      "plan": { "lowerWalls": { "rect": ["baseSize + 2 * aisle", "bay"], "center": [0, "-half - 1.5 * bay"] } },
      "build": [
        { "op": "columns", "name": "porchColumnsRight", "at": { "points": [["half", "-half - bay", 0], ["half", "-half - 2 * bay", 0]] },
          "profile": "porchColumn", "foot": "ground", "top": "beltFoot",
          "base": [{ "profile": "porchPlinth", "height": "150mm" }, { "profile": "porchTorus", "height": "70mm" }, { "profile": "porchFillet", "height": "30mm" }],
          "capital": [{ "profile": "porchAstragal", "height": "35mm" }, { "profile": "porchEchinus", "height": "90mm" }, { "profile": "porchAbacus", "height": "60mm" }] },
        { "op": "columns", "name": "porchColumnsLeft", "at": { "points": [["-half", "-half - bay", 0], ["-half", "-half - 2 * bay", 0]] },
          "profile": "porchColumn", "foot": "ground", "top": "beltFoot",
          "base": [{ "profile": "porchPlinth", "height": "150mm" }, { "profile": "porchTorus", "height": "70mm" }, { "profile": "porchFillet", "height": "30mm" }],
          "capital": [{ "profile": "porchAstragal", "height": "35mm" }, { "profile": "porchEchinus", "height": "90mm" }, { "profile": "porchAbacus", "height": "60mm" }] },
        { "op": "arches", "name": "porchArchesRight", "between": "porchColumnsRight", "open": true, "profile": "porchArch", "under": { "columns": 0 }, "spring": "porchArchSpring" },
        { "op": "arches", "name": "porchArchesLeft", "between": "porchColumnsLeft", "open": true, "profile": "porchArch", "under": { "columns": 0 }, "spring": "porchArchSpring" },
        { "op": "group", "name": "bay", "use": "porchBay", "move": [0, "-bay", 0] },
        { "op": "surface", "name": "lowRoofRight", "type": "glazing", "evenBays": false,
          "base": ["half + aisle", "-half - 2 * bay", "lowRoofEave"], "alongX": ["half + aisle", "-half - bay", "lowRoofEave"],
          "alongZ": ["half", "-half - 2 * bay", "beltFoot"], "tangent": "lowRoofTangent" },
        { "op": "surface", "name": "lowRoofLeft", "type": "glazing", "evenBays": false,
          "base": ["-half - aisle", "-half - bay", "lowRoofEave"], "alongX": ["-half - aisle", "-half - 2 * bay", "lowRoofEave"],
          "alongZ": ["-half", "-half - bay", "beltFoot"], "tangent": "lowRoofTangent" },
        { "op": "window", "name": "lowerWallRight1", "sidesOnEdges": true, "side": ["lowerWalls", 1], "part": [0, 2], "foot": "foundationTop", "top": "lowRoofEave", "spring": "lowWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "window", "name": "lowerWallRight2", "sidesOnEdges": true, "side": ["lowerWalls", 1], "part": [1, 2], "foot": "foundationTop", "top": "lowRoofEave", "spring": "lowWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
