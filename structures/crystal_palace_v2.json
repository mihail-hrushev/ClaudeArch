        { "op": "window", "name": "lowerWallLeft1", "sidesOnEdges": true, "side": ["lowerWalls", 3], "part": [0, 2], "foot": "foundationTop", "top": "lowRoofEave", "spring": "lowWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "window", "name": "lowerWallLeft2", "sidesOnEdges": true, "side": ["lowerWalls", 3], "part": [1, 2], "foot": "foundationTop", "top": "lowRoofEave", "spring": "lowWindowSpring",
          "profiles": { "frame": "windowFrame", "frameVertical": "windowFrameVertical", "post": "windowPost", "rib": "windowRib" },
          "glass": { "thickness": "10mm", "material": "blueGlass" }, "solid": { "thickness": "20mm" } },
        { "op": "band", "name": "foundation", "plan": "lowerWalls", "sides": [1, 3], "thickness": "250mm", "z": [0, "foundationTop"], "material": "masonry" }
      ]
