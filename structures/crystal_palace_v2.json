                      "rect": ["30mm", "80mm"] }, 
                      "verticalFrame": { "rect": ["30mm", "60mm"] } }
    },
    "glassBeam": { "extends": "glazing", "tile": { "preset": "square", "align": "bottom-left" },
                   "profiles": { "mainRib": { "rect": ["100mm", "140mm"] }, "cutRib": { "rect": ["100mm", "140mm"] },
