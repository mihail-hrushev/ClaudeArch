        { "op": "surface", "name": "endRoof2", "type": "glazing", "evenBays": false,
          "base": { "corner": ["porchEnd", 1], "z": "columnMiddle" }, "alongX": { "corner": ["porchEnd", 2], "z": "columnMiddle" }, "alongZ": [0, "-half - 2 * bay", "beamFoot"], "tangent": "porchEndTangent",
          "cuts": [{ "plan": "porchEnd", "side": 1, "end": 0 }, { "plan": "porchEnd", "side": 1, "end": 1 }] },
