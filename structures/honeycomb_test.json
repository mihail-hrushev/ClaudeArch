{
  "name": "honeycomb_test",
  "description": "Test of honeycombSurface: a glass surface placed like surface2 (three points, `tangent` bending the section, `tangentX` the base line) tiled with flat hexagons. Neighbouring tiles share one rib; `offset` and `offsets` move the glass of a tile forward (positive) or back along its own normal.",
  "material": "steel",
  "view": { "target": [1300, 300, 300], "radius": 3200, "alpha": -70, "beta": 70 },
  "profiles": {
    "rib": { "rect": ["50mm", "120mm"] },
    "edgeRib": { "rect": ["80mm", "200mm"] },
    "frame": { "rect": ["30mm", "80mm"] }
  },
  "materials": {
    "steel": { "color": [0.8, 0.8, 0.8], "metallic": 0.05, "roughness": 0.01 },
    "blueGlass": { "color": [0.14, 0.2, 0.54], "alpha": 0.4, "metallic": 0.95, "roughness": 0.01, "emissive": [0.3, 0.3, 0.3] }
  },
  "glass": {
    "hex": { "width": "900mm", "length": "900mm", "thickness": "12mm", "gap": "15mm", "material": "blueGlass" }
  },
  "surfaces": {
    "honeycomb": {
      "tile": { "preset": "hex" },
      "profiles": { "mainRib": "rib", "cutRib": "edgeRib", "horizontalFrame": "frame" }
    }
  },
  "build": [
    { "op": "honeycombSurface", "name": "honeyWall", "type": "honeycomb",
      "base": [-800, 0, 700], "alongX": [0, 0, 700], "alongZ": [100, -500, 0],
      "tangent": [-1, 0], "tangentX": [1, 0], "offset": "-90mm",
      "cuts": [{ "point": [-800, 0, 700], "normal": [0.866025, 0.5, 0] },
               { "point": [0, 0, 700], "normal": [-0.866025, 0.5, 0] }] },
    
    { "op": "honeycombSurface", "name": "honeyWall2", "type": "honeycomb",
      "base": [-800, 0, 730], "alongX": [0, 0, 730], "alongZ": [100, 500, 1400],
      "tangent": [1, 0], "tangentX": [1, 0],
      "cuts": [{ "point": [-800, 0, 700], "normal": [0.866025, 0.5, 0] },
               { "point": [0, 0, 700], "normal": [-0.866025, 0.5, 0] }] },

    { "op": "honeycombSurface", "name": "dome", "type": "honeycomb",
      "base": [0, 0, 0], "alongX": ["8m", 0, 0], "alongZ": [0, "3m", "5m"],
      "tangent": [0.2, 1], "tangentX": [1, -0.5],
      "offsets": [
        { "cells": [[3, 2], [4, 3], [5, 2]], "offset": "250mm" },
        { "cells": [[3, 4], [5, 4]], "offset": "-250mm" }
      ] },
    { "op": "honeycombSurface", "name": "apse", "type": "honeycomb",
      "base": ["11m", "3m", 0], "alongX": ["19m", "3m", 0], "alongZ": ["11m", "6m", "6m"],
      "tangent": [0, 1], "tangentX": [0, -1], "sweep": "revolve", "orientation": "flat", "cell": "1100mm" },
    { "op": "honeycombSurface", "name": "saddle", "type": "honeycomb",
      "base": ["22m", 0, 0], "alongX": ["30m", 0, 0], "alongZ": ["22m", "3m", "5m"],
      "tangent": [0.2, 1], "tangentX": [1, 0.5], "offset": "-60mm" }
  ]
}
